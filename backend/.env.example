# Application metadata database (stores users/projects/assessments - NOT the target vector DB)
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=vector_platform
APP_DB_PASSWORD=change-me
APP_DB_NAME=vector_platform

# JWT
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=8h

# Server
PORT=3000
NODE_ENV=development

# API-wide rate limiting (Sprint 9 security hardening). /auth/login and
# /auth/register have their own tighter, non-configurable limits (see
# auth.controller.ts) since they are the classic brute-force target.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Target vector database connections (Phase 4 - Implementation & Provisioning).
# These are the CUSTOMER's databases that ingested vectors live in - entirely
# separate from APP_DB_* above (this app's own metadata store). Only set the
# block for whichever platform a project resolved to; adapters connect lazily
# and only fail when actually used, so the app runs fine with none configured.
TARGET_PG_HOST=
TARGET_PG_PORT=5432
TARGET_PG_USER=
TARGET_PG_PASSWORD=
TARGET_PG_DATABASE=
TARGET_PG_SSL=false

TARGET_ORACLE_USER=
TARGET_ORACLE_PASSWORD=
TARGET_ORACLE_CONNECT_STRING=

TARGET_MILVUS_ADDRESS=
TARGET_MILVUS_TOKEN=
TARGET_MILVUS_SSL=false

# Phase 5 ingestion pipeline - optional. Without this, embeddings are
# generated by a deterministic offline stand-in (see embedding-client).
OPENAI_API_KEY=

# Config file overrides (all optional - default to ./config/*.yaml)
THRESHOLDS_CONFIG_PATH=./config/thresholds.yaml
DATABASES_CONFIG_PATH=./config/databases.yaml
EMBEDDINGS_CONFIG_PATH=./config/embeddings.yaml
INDEXES_CONFIG_PATH=./config/indexes.yaml
INFRASTRUCTURE_CONFIG_PATH=./config/infrastructure.yaml
PATTERNS_CONFIG_PATH=./config/patterns.yaml
INFERENCE_CONFIG_PATH=./config/inference.yaml

# AI Factory guided workflow (Waves 1+). Off by default - the existing VectorDB
# workflow is unchanged unless this is set to true.
AI_FACTORY_ENABLED=false
AI_FACTORY_CONFIG_PATH=./config/ai-factory.yaml
AI_FACTORY_MODELS_CONFIG_PATH=./config/models.yaml
AI_FACTORY_SERVING_CONFIG_PATH=./config/serving.yaml
AI_FACTORY_INFRASTRUCTURE_CONFIG_PATH=./config/infrastructure-targets.yaml
AI_FACTORY_RAG_AGENT_CONFIG_PATH=./config/rag-agent.yaml
AI_FACTORY_SECURITY_CONFIG_PATH=./config/security-governance.yaml
AI_FACTORY_PERFORMANCE_CONFIG_PATH=./config/performance.yaml
AI_FACTORY_FINOPS_CONFIG_PATH=./config/finops.yaml
AI_FACTORY_OPERATIONS_CONFIG_PATH=./config/operations.yaml

# Token Observability (AI Factory Wave 12). Needs AI_FACTORY_ENABLED too. Pricing
# treatment and estimation assumptions; prices themselves are seeded into the
# versioned ai_model_prices table from inference.yaml and embeddings.yaml.
TOKEN_OBSERVABILITY_ENABLED=false
TOKEN_OBSERVABILITY_CONFIG_PATH=./config/token-observability.yaml
# Live telemetry ingest (POST /api/observability/usage-events and /api/observability/v1/traces,
# authenticated by project ingest keys). Body limit for usage batches only - every other
# route keeps 100 KB - and requests per minute per client for machine ingest.
TOKEN_INGEST_MAX_BODY=5mb
TOKEN_INGEST_RATE_LIMIT_PER_MIN=600
# Token alerts (every 15 min, see config alerts), tenant-id visibility
# (privileged = admins and architects only, or all), and retention clean-up (daily).
TOKEN_ALERTS_ENABLED=true
TOKEN_TENANT_VISIBILITY=privileged
TOKEN_RETENTION_ENABLED=true
TOKEN_USAGE_RETENTION_DAYS=395
TOKEN_ROLLUP_RETENTION_DAYS=1095
TOKEN_ALERT_RETENTION_DAYS=180
