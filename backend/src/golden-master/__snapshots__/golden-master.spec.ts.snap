    },
    {
      "formula": "1 GPU × (24 GB × 0.9 - 2 GB runtime) - 8 GB weights",
      "result": "11.6 GB",
      "step": "KV memory free per replica",
    },
    {
      "formula": "min(76 by memory, 17 by 50 ms TPOT, 256 cap)",
      "result": "17 concurrent sequences",
      "step": "Batch size",
    },
    {
      "formula": "(active weights + 17 × KV read) ÷ (1 × 300 GB/s × 0.7 efficiency)",
      "result": "49.6 ms (target 50)",
      "step": "Time per output token",
    },
    {
      "formula": "prefill of 2000 tokens × 1.5 contention + one decode step",
      "result": "547 ms (target 2000)",
      "step": "Time to first token",
    },
    {
      "formula": "0.7 utilisation ÷ GPU-seconds per request (prefill + 300 tokens × step ÷ batch)",
      "result": "0.58 req/s",
      "step": "Replica capacity",
    },
    {
      "formula": "max(2 min for availability, ceil(3.47 peak ÷ 0.58))",
      "result": "6 at peak · 2 at average (6 GPUs at peak)",
      "step": "Replicas",
    },
    {
      "formula": "autoscaled GPU cost $981 × (1 + 20%) + $4,000 platform",
      "result": "$5,177/month · $0.7405 per 1M tokens",
      "step": "Self-hosted cost",
    },
  ],
}
`;

