    "Model licence: Llama 3.3 Community License (acceptable-use policy; 700M MAU clause).",
    "Availability 99.9% needs >= 2 replicas across failure domains (and a second region or provider for API-based designs).",
  ],
  "rulesVersion": "inference-2026.09-1",
  "workings": [
    {
      "formula": "100,000 requests/day ÷ 86,400 s",
      "result": "1.16 req/s",
      "step": "Average load",
    },
    {
      "formula": "1.16 × 3 peak-to-average",
      "result": "3.47 req/s",
      "step": "Peak load",
    },
    {
      "formula": "100,000 × 30.4 days × (2000 in + 300 out)",
      "result": "6,992 M tokens",
      "step": "Monthly tokens",
    },
    {
      "formula": "3,040,000 req × (2000 × $3.00 + 300 × $15.00) ÷ 1M",
      "result": "$31,920/month",
      "step": "Managed API cost",
    },
    {
      "formula": "70.6B params × 1 bytes (FP8 (W8A8))",
      "result": "70.6 GB",
      "step": "Model weights",
    },
    {
      "formula": "2 × 80 layers × 8 KV heads × 128 head dim × 1 bytes",
      "result": "160 KiB",
      "step": "KV cache per token",
    },
    {
      "formula": "1 GPU × (141 GB × 0.9 - 2 GB runtime) - 70.6 GB weights",
      "result": "54.3 GB",
      "step": "KV memory free per replica",
    },
    {
      "formula": "min(144 by memory, 276 by 50 ms TPOT, 256 cap)",
      "result": "144 concurrent sequences",
      "step": "Batch size",
    },
    {
      "formula": "(active weights + 144 × KV read) ÷ (1 × 4800 GB/s × 0.7 efficiency)",
      "result": "36.1 ms (target 50)",
      "step": "Time per output token",
    },
    {
      "formula": "prefill of 2000 tokens × 1.5 contention + one decode step",
      "result": "571 ms (target 2000)",
      "step": "Time to first token",
    },
    {
      "formula": "0.7 utilisation ÷ GPU-seconds per request (prefill + 300 tokens × step ÷ batch)",
      "result": "1.62 req/s",
      "step": "Replica capacity",
    },
    {
      "formula": "max(2 min for availability, ceil(3.47 peak ÷ 1.62))",
      "result": "3 at peak · 2 at average (3 GPUs at peak)",
      "step": "Replicas",
    },
    {
      "formula": "autoscaled GPU cost $12,848 × (1 + 20%) + $4,000 platform",
      "result": "$19,418/month · $2.78 per 1M tokens",
      "step": "Self-hosted cost",
    },
  ],
}
`;

