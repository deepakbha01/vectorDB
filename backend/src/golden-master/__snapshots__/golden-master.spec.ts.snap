exports[`Golden master - existing VectorDB workflow (must not change unintentionally) Phase 2/3 - schema and index artefacts for every platform index artefacts: lancedb 1`] = `
{
  "hnsw": {
    "notes": [
      "LanceDB's HNSW variant is layered over IVF partitioning (IVF_HNSW_SQ) rather than a pure flat-graph HNSW index.",
      "metric maps to LanceDB's distance_type parameter ('cosine') - verify the exact parameter name against your LanceDB SDK version.",
    ],
    "statement": "{
  "index_type": "IVF_HNSW_SQ",
  "metric": "cosine",
  "m": 16,
  "ef_construction": 200
}",
  },
  "ivfFlat": {
    "notes": [
      "num_sub_vectors is omitted/ignored for a flat (non-quantized) IVF index.",
      "At query time, set nprobes = 16 for the configured recall/latency trade-off.",
      "metric maps to LanceDB's distance_type parameter ('l2') - verify the exact parameter name against your LanceDB SDK version.",
    ],
    "statement": "{
  "index_type": "IVF_PQ",
  "metric": "euclidean",
  "num_partitions": 1024
}",
  },
}
`;

